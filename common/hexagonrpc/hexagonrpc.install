mask_bad_adsp_service() {
  if command -v systemctl >/dev/null 2>&1; then
    # Attaching a root PD hexagonrpcd instance to /dev/fastrpc-adsp
    # conflicts with the audio/WiFi coprocessor firmware sharing the ADSP
    # on this device (pipa), breaking audio after suspend/resume and WiFi
    # connectivity. Sensors are served via SDSP instead.
    systemctl stop hexagonrpcd-adsp-rootpd.service >/dev/null 2>&1 || true
    systemctl disable hexagonrpcd-adsp-rootpd.service >/dev/null 2>&1 || true
    systemctl mask hexagonrpcd-adsp-rootpd.service >/dev/null 2>&1 || true
  fi
}

post_install() {
  mask_bad_adsp_service
}

post_upgrade() {
  mask_bad_adsp_service
}
