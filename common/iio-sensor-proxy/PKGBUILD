pkgname=iio-sensor-proxy
_commit=0085ddf8ecb173a1c5fcf2344aa40e561125354f
pkgver=3.9
pkgrel=1
pkgdesc="IIO accelerometer sensor to input device proxy (with libssc support)"
arch=('x86_64' 'aarch64')
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
license=('GPL3')
depends=('dbus' 'glib2' 'libgudev' 'libssc>=0.2.2' 'polkit' 'systemd')
makedepends=('meson' 'gcc' 'gtk-doc' 'umockdev')
provides=('iio-sensor-proxy-pipa')
conflicts=('iio-sensor-proxy-pipa')
source=("${url}/-/archive/${_commit}/iio-sensor-proxy-${_commit}.tar.gz"
        "0001-iio-sensor-proxy-Do-not-exit-based-on-sensor-events.patch"
        "0002-drv-ssc-fix-polling-lifecycle.patch")
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "iio-sensor-proxy-${_commit}"
  patch -p1 < ../0001-iio-sensor-proxy-Do-not-exit-based-on-sensor-events.patch
  patch -p1 < ../0002-drv-ssc-fix-polling-lifecycle.patch
}

build() {
  cd "iio-sensor-proxy-${_commit}"
  meson setup build --prefix=/usr -Dgtk-tests=false -Dssc-support=enabled
  ninja -C build
}

package() {
  cd "iio-sensor-proxy-${_commit}"
  DESTDIR="$pkgdir" ninja -C build install
}
