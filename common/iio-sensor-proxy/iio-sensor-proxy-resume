#!/bin/bash
# After resume, the QMI/QRTR connections to the DSP are stale.
# Restart hexagonrpcd (reloads DSP firmware) then iio-sensor-proxy.
case "$1" in
    post)
        (
            sleep 2
            systemctl restart hexagonrpcd-adsp-sensorspd hexagonrpcd-sdsp 2>/dev/null
            sleep 1
            systemctl restart iio-sensor-proxy 2>/dev/null
        ) &
        ;;
esac