#!/bin/bash
# After resume, the QMI/QRTR connections to the DSP are stale.
# Trigger a udev re-add on fastrpc devices so iio-sensor-proxy's
# sensor_changes callback re-discovers sensors without a full
# service restart (which takes ~15s).
case "$1" in
    post)
        udevadm trigger --action=add --subsystem-match=misc \
            --property-match=IIO_SENSOR_PROXY_TYPE 2>/dev/null
        ;;
esac