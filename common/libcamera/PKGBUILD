pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-docs
  libcamera-ipa
  libcamera-tools
  gst-plugin-libcamera
  python-libcamera
)
pkgver=0.7.1
pkgrel=3
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS"
arch=('x86_64' 'aarch64')
url="https://libcamera.org/"
license=('LGPL2.1' 'GPL2')
makedepends=('cmake' 'doxygen' 'git' 'glib2' 'graphviz' 'gst-plugins-base' 'gtest' 'libdrm' 'libjpeg-turbo'
             'libtiff' 'meson' 'ninja' 'pybind11' 'python-jinja' 'python-ply' 'python-pyyaml'
             'python-sphinx' 'python-sphinx-book-theme' 'python-sphinxcontrib-doxylink'
             'qt6-base' 'qt6-tools' 'sdl2' 'systemd' 'texlive-core')
source=("git+https://git.libcamera.org/libcamera/libcamera.git#tag=v${pkgver}"
        '0001-ipa-libipa-Add-sensor-helper-for-OV13B10.patch'
        '0002-libcamera-add-pipa-sensor-properties.patch'
        'hi846.yaml'
        'ov13b10.yaml')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd "$pkgname"
  patch -p1 < ../0001-ipa-libipa-Add-sensor-helper-for-OV13B10.patch
  patch -p1 < ../0002-libcamera-add-pipa-sensor-properties.patch
}

build() {
  cd "$pkgname"
  meson setup build \
    --prefix=/usr \
    -Dcpp_args=-Wno-array-bounds \
    -Ddocumentation=enabled \
    -Dpipelines=auto \
    -Dipas=ipu3,mali-c55,rkisp1,rpi/pisp,rpi/vc4,simple,vimc \
    -Dv4l2=enabled \
    -Dgstreamer=enabled \
    -Dcam=enabled \
    -Dlc-compliance=enabled \
    -Dqcam=enabled \
    -Dpycamera=enabled \
    -Dtest=false
  meson compile -C build
}

package_libcamera() {
  depends=('glibc' 'gnutls' 'libcamera-ipa' 'libelf' 'libglvnd' 'libstdc++' 'libunwind' 'libyaml' 'systemd-libs')
  optdepends=('gst-plugin-libcamera: GStreamer plugin'
              'libcamera-docs: for documentation'
              'libcamera-tools: for applications'
              'python-libcamera: for Python bindings')
  provides=('libcamera.so=0.7-64' 'libcamera-base.so=0.7-64')

  cd "$pkgname"
  DESTDIR="$pkgdir" meson install -C build

  install -Dm644 ../hi846.yaml "$pkgdir/usr/share/libcamera/ipa/simple/hi846.yaml"
  install -Dm644 ../ov13b10.yaml "$pkgdir/usr/share/libcamera/ipa/simple/ov13b10.yaml"

  # remove bundled libpisp (provided by separate system package)
  rm -rf "$pkgdir"/usr/{include/libpisp,lib/libpisp.so*,lib/pkgconfig/libpisp.pc,share/libpisp}

  cd "$pkgdir"
  _pick libcamera-docs usr/share/doc
  _pick libcamera-ipa usr/lib/libcamera/
  _pick libcamera-tools usr/bin/cam usr/bin/qcam usr/bin/lc-compliance usr/bin/libcamera-bug-report
  _pick gst-plugin-libcamera usr/lib/gstreamer-1.0/
  _pick python-libcamera usr/lib/python*
}

package_libcamera-docs() {
  pkgdesc+=" - documentation"
  mv -v "$pkgname"/* "$pkgdir"
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  depends=('gcc-libs' 'glibc' 'libcamera')
  mv -v "$pkgname"/* "$pkgdir"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  depends=('gcc-libs' 'glibc' 'libcamera' 'libdrm' 'libjpeg-turbo' 'libtiff' 'qt6-base' 'sdl2')
  mv -v "$pkgname"/* "$pkgdir"
}

package_gst-plugin-libcamera() {
  pkgdesc="Multimedia graph framework - libcamera plugin"
  depends=('gcc-libs' 'glibc' 'glib2' 'gstreamer' 'gst-plugins-base-libs' 'libcamera')
  mv -v "$pkgname"/* "$pkgdir"
}

package_python-libcamera() {
  pkgdesc+=" - Python bindings"
  depends=('glibc' 'libcamera' 'python')
  mv -v "$pkgname"/* "$pkgdir"
}
