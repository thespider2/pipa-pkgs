pkgname=grub2-theme-endeavouros-classic
pkgver=1.0
pkgrel=3
pkgdesc="EndeavourOS Classic GRUB Theme"
arch=('any')
url="https://github.com/EndeavourOS-Community-Editions/grub2-theme-endeavouros-classic"
license=('GPL3')
depends=('grub')
makedepends=('git')
source=("git+https://github.com/EndeavourOS-Community-Editions/grub2-theme-endeavouros-classic.git")
sha256sums=('SKIP')

package() {
  cd "$pkgname"
  install -d "$pkgdir/usr/share/grub/themes/endeavouros"
  cp -r EndeavourOS "$pkgdir/usr/share/grub/themes/endeavouros/"
}
