#!/bin/sh
set -eu

log_debug() {
  logger -t pipa-sleep-debug "iio-sensor-proxy-resume: $*"
}

STATE_DIR=/run/iio-sensor-proxy
STATE_FILE="$STATE_DIR/was-active-before-sleep"
UNIT=iio-sensor-proxy.service

case "${1:-}" in
  pre)
    log_debug "hook start phase=pre"
    mkdir -p "$STATE_DIR"

    if systemctl is-active --quiet "$UNIT"; then
      : > "$STATE_FILE"
      log_debug "stopping $UNIT"
      systemctl stop "$UNIT" >/dev/null 2>&1 || true
    else
      rm -f "$STATE_FILE"
    fi
    log_debug "hook end phase=pre"
    ;;
  post)
    log_debug "hook start phase=post"
    if [ -f "$STATE_FILE" ]; then
      rm -f "$STATE_FILE"
      sleep 2
      log_debug "starting $UNIT"
      systemctl start "$UNIT" >/dev/null 2>&1 || true
    fi
    log_debug "hook end phase=post"
    ;;
esac
