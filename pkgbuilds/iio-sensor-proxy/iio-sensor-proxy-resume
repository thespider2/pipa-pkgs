#!/bin/sh
set -eu

STATE_DIR=/run/iio-sensor-proxy
STATE_FILE="$STATE_DIR/was-active-before-sleep"
UNIT=iio-sensor-proxy.service

case "${1:-}" in
  pre)
    mkdir -p "$STATE_DIR"

    if systemctl is-active --quiet "$UNIT"; then
      : > "$STATE_FILE"
      systemctl stop "$UNIT" >/dev/null 2>&1 || true
    else
      rm -f "$STATE_FILE"
    fi
    ;;
  post)
    if [ -f "$STATE_FILE" ]; then
      rm -f "$STATE_FILE"
      sleep 2
      systemctl start "$UNIT" >/dev/null 2>&1 || true
    fi
    ;;
esac
