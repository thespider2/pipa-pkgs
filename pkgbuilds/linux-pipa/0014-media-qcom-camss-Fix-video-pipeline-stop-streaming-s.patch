From 760780474fc594c9ce7d034f02dafca1d842f977 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Tue, 30 Jun 2026 22:36:36 +0300
Subject: [PATCH] media: qcom: camss: Fix video pipeline stop streaming state
 tracking

video_stop_streaming() walks the media pipeline and calls s_stream(0)
on every subdev, but if video_start_streaming() failed partway through
(an intermediate subdev's s_stream(1) failed), the previously-started
subdevs retain s_stream_enabled=1. On the next STREAMOFF,
video_stop_streaming calls s_stream(0) on all subdevs including the
one that was never started, triggering a WARN_ON in v4l2-subdev core.

Fix this by:
- In video_start_streaming error path: properly unwind s_stream on
  subdevs that were successfully started before the failure point.
- In video_stop_streaming: don't abort on a single subdev stop failure
  (continue best-effort teardown of remaining subdevs).

This prevents libcamera PipelineHandler::stop() from crashing due to
VIDIOC_STREAMOFF returning errors from a partially-torn-down pipeline.
---
 .../media/platform/qcom/camss/camss-video.c   | 32 +++++++++++++++----
 1 file changed, 26 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 831486e14754..31d6f89f7836 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -246,6 +246,7 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	struct video_device *vdev = &video->vdev;
 	struct media_entity *entity;
 	struct media_pad *pad;
+	struct media_pad *start_pad = NULL;
 	struct v4l2_subdev *subdev;
 	int ret;
 
@@ -273,13 +274,34 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 		subdev = media_entity_to_v4l2_subdev(entity);
 
 		ret = v4l2_subdev_call(subdev, video, s_stream, 1);
-		if (ret < 0 && ret != -ENOIOCTLCMD)
+		if (ret < 0 && ret != -ENOIOCTLCMD) {
+			start_pad = pad;
 			goto error;
+		}
 	}
 
 	return 0;
 
 error:
+	entity = &vdev->entity;
+	while (1) {
+		pad = &entity->pads[0];
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			break;
+
+		pad = media_pad_remote_pad_first(pad);
+		if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+			break;
+
+		if (pad == start_pad)
+			break;
+
+		entity = pad->entity;
+		subdev = media_entity_to_v4l2_subdev(entity);
+
+		v4l2_subdev_call(subdev, video, s_stream, 0);
+	}
+
 	video_device_pipeline_stop(vdev);
 
 flush_buffers:
@@ -311,11 +333,9 @@ static void video_stop_streaming(struct vb2_queue *q)
 		subdev = media_entity_to_v4l2_subdev(entity);
 
 		ret = v4l2_subdev_call(subdev, video, s_stream, 0);
-
-		if (ret) {
-			dev_err(video->camss->dev, "Video pipeline stop failed: %d\n", ret);
-			return;
-		}
+		if (ret && ret != -ENOIOCTLCMD)
+			dev_err(video->camss->dev,
+				"Video pipeline stop failed: %d\n", ret);
 	}
 
 	video_device_pipeline_stop(vdev);
-- 
2.54.0

