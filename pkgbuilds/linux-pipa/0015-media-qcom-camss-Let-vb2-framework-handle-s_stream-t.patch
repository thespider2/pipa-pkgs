From 1d469bf4d42c5a3bf8afff4ad28f3e83a1ef0b97 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Tue, 30 Jun 2026 23:12:41 +0300
Subject: [PATCH] media: qcom: camss: Let vb2 framework handle s_stream
 teardown on error

The previous fix added s_stream(0) unwind in the video_start_streaming
error path, but vb2 framework guarantees that if start_streaming fails,
stop_streaming is always called afterward. The double s_stream(0) call
(on the error path + stop_streaming) triggers WARN_ON in v4l2-subdev
for already-stopped subdevs. Remove the redundant unwind and let
video_stop_streaming handle all cleanup.
---
 .../media/platform/qcom/camss/camss-video.c   | 24 +------------------
 1 file changed, 1 insertion(+), 23 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 31d6f89f7836..baf83757e413 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -246,7 +246,6 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	struct video_device *vdev = &video->vdev;
 	struct media_entity *entity;
 	struct media_pad *pad;
-	struct media_pad *start_pad = NULL;
 	struct v4l2_subdev *subdev;
 	int ret;
 
@@ -274,34 +273,13 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 		subdev = media_entity_to_v4l2_subdev(entity);
 
 		ret = v4l2_subdev_call(subdev, video, s_stream, 1);
-		if (ret < 0 && ret != -ENOIOCTLCMD) {
-			start_pad = pad;
+		if (ret < 0 && ret != -ENOIOCTLCMD)
 			goto error;
-		}
 	}
 
 	return 0;
 
 error:
-	entity = &vdev->entity;
-	while (1) {
-		pad = &entity->pads[0];
-		if (!(pad->flags & MEDIA_PAD_FL_SINK))
-			break;
-
-		pad = media_pad_remote_pad_first(pad);
-		if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
-			break;
-
-		if (pad == start_pad)
-			break;
-
-		entity = pad->entity;
-		subdev = media_entity_to_v4l2_subdev(entity);
-
-		v4l2_subdev_call(subdev, video, s_stream, 0);
-	}
-
 	video_device_pipeline_stop(vdev);
 
 flush_buffers:
-- 
2.54.0

