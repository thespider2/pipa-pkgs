prepare() {
  cd "$srcdir/$_srcname-$pkgver"

  cp "$srcdir/config-$_flavor.$arch" .config

  for patch in "$srcdir"/0*.patch; do
    patch -Np1 -i "$patch"
  done

  make ARCH=arm64 LLVM=1 olddefconfig
}

build() {
  cd "$srcdir/$_srcname-$pkgver"

  unset LDFLAGS
  make ARCH=arm64 LLVM=1 \
    KBUILD_BUILD_VERSION="$((pkgrel + 1))-${_flavor}" \
    Image Image.gz modules dtbs
}

package_linux-pipa() {
  pkgdesc="The Linux kernel and modules for Xiaomi Pad 6"
  depends=('coreutils' 'dracut' 'kmod')
  provides=('linux')

  cd "$srcdir/$_srcname-$pkgver"

  local kernver="$(make ARCH=arm64 LLVM=1 kernelrelease)"

  make ARCH=arm64 LLVM=1 \
    INSTALL_PATH="$pkgdir/boot" \
    INSTALL_MOD_PATH="$pkgdir/usr" \
    INSTALL_MOD_STRIP=1 \
    INSTALL_DTBS_PATH="$pkgdir/boot/dtbs" \
    modules_install zinstall dtbs_install

  cp arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
  cp arch/arm64/boot/Image "$pkgdir/boot/Image"
  cp System.map "$pkgdir/boot/System.map-$kernver"
  cp .config "$pkgdir/boot/config-$kernver"

  mkdir -p "$pkgdir/usr/lib/modules/$kernver/devicetree"
  cp arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa-*.dtb \
    "$pkgdir/usr/lib/modules/$kernver/devicetree/"
  ln -s devicetree "$pkgdir/usr/lib/modules/$kernver/dtb"
  cp arch/arm64/boot/Image.gz "$pkgdir/usr/lib/modules/$kernver/vmlinuz"
  cp arch/arm64/boot/Image "$pkgdir/usr/lib/modules/$kernver/vmlinuz.uncompressed"

  install -Dm644 include/config/kernel.release \
    "$pkgdir/usr/share/kernel/$_flavor/kernel.release"

  rm -f "$pkgdir/usr/lib/modules/$kernver/build"
  rm -f "$pkgdir/usr/lib/modules/$kernver/source"
}

package_linux-pipa-headers() {
  pkgdesc="Header files and scripts for building modules for Linux kernel"
  provides=('linux-headers')

  cd "$srcdir/$_srcname-$pkgver"
  make ARCH=arm64 LLVM=1 INSTALL_HDR_PATH="$pkgdir/usr" headers_install
}
