#!/usr/bin/env bash
set -euo pipefail

BOOT_DIR=/boot
LIMINE_CFG="$BOOT_DIR/limine.conf"
LIMINE_EFI_SOURCE=/usr/share/limine/BOOTAA64.EFI
ESP_DEVICE_DEFAULT=/dev/disk/by-partlabel/rawdump
ESP_MOUNT_HINT=/efi
ESP_LABEL_DEFAULT=EOSPIPAESP
declare -a DTB_RELS=()
RAW_KERNEL_REL=Image
GZIP_KERNEL_REL=Image.gz
INITRAMFS_STABLE_REL=initramfs-linux-pipa.img
INITRAMFS_STABLE_PATH="$BOOT_DIR/$INITRAMFS_STABLE_REL"
DEFAULT_CMDLINE='rw rootwait console=tty0 console=ttyS0 earlycon quiet splash'

log() {
    printf 'pipa-limine-config: %s\n' "$*" >&2
}

tmp_cfg=
tmp_esp_mount=

cleanup() {
    if [ -n "$tmp_esp_mount" ] && mountpoint -q "$tmp_esp_mount"; then
        umount "$tmp_esp_mount" >/dev/null 2>&1 || true
    fi

    if [ -n "$tmp_esp_mount" ] && [ -d "$tmp_esp_mount" ]; then
        rmdir "$tmp_esp_mount" >/dev/null 2>&1 || true
    fi

    if [ -n "$tmp_cfg" ] && [ -f "$tmp_cfg" ]; then
        rm -f "$tmp_cfg"
    fi
}

is_fat_filesystem() {
    case "$1" in
        vfat|msdos|fat|fat16|fat32)
            return 0
            ;;
    esac

    return 1
}

ensure_tmpdir() {
    local tmpdir="${TMPDIR:-/tmp}"

    mkdir -p /tmp /var/tmp
    chmod 1777 /tmp /var/tmp 2>/dev/null || true

    if [ ! -d "$tmpdir" ] || [ ! -w "$tmpdir" ]; then
        tmpdir=/tmp
    fi

    export TMPDIR="$tmpdir"
}

require_file() {
    local path="$1"
    if [ ! -e "$path" ]; then
        log "missing required file: $path"
        exit 1
    fi
}

dtb_title() {
    case "$(basename "$1")" in
        sm8250-xiaomi-pipa-csot.dtb)
            printf 'CSOT Panel'
            ;;
        sm8250-xiaomi-pipa-tianma.dtb)
            printf 'Tianma Panel'
            ;;
        sm8250-xiaomi-pipa.dtb)
            printf 'Generic DTB'
            ;;
        *)
            printf '%s' "$(basename "$1" .dtb)"
            ;;
    esac
}

discover_dtbs() {
    local path
    local -a split_dtbs=()

    if [ -n "${PIPA_DTB_REL:-}" ]; then
        require_file "$BOOT_DIR/$PIPA_DTB_REL"
        DTB_RELS=("$PIPA_DTB_REL")
        return
    fi

    shopt -s nullglob
    for path in "$BOOT_DIR"/dtbs/qcom/sm8250-xiaomi-pipa-*.dtb; do
        split_dtbs+=("${path#$BOOT_DIR/}")
    done
    shopt -u nullglob

    if [ "${#split_dtbs[@]}" -gt 0 ]; then
        DTB_RELS=("${split_dtbs[@]}")
    elif [ -f "$BOOT_DIR/dtbs/qcom/sm8250-xiaomi-pipa.dtb" ]; then
        DTB_RELS=(dtbs/qcom/sm8250-xiaomi-pipa.dtb)
    fi

    if [ "${#DTB_RELS[@]}" -eq 0 ]; then
        log "no Xiaomi Pad 6 DTB found under $BOOT_DIR/dtbs/qcom"
        exit 1
    fi
}

find_esp_dir() {
    local path=
    local fstype=

    for path in "${PIPA_ESP_DIR:-}" /efi /boot/efi; do
        [ -n "$path" ] || continue

        if ! mountpoint -q "$path"; then
            continue
        fi

        fstype="$(findmnt -no FSTYPE "$path" 2>/dev/null || true)"
        if is_fat_filesystem "$fstype"; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    if mountpoint -q "$BOOT_DIR"; then
        fstype="$(findmnt -no FSTYPE "$BOOT_DIR" 2>/dev/null || true)"
        if is_fat_filesystem "$fstype"; then
            printf '%s\n' "$BOOT_DIR"
            return 0
        fi
    fi

    return 1
}

mount_esp_dir() {
    local esp_dir=
    local esp_device=

    if esp_dir="$(find_esp_dir)"; then
        printf '%s\n' "$esp_dir"
        return 0
    fi

    esp_device="${PIPA_ESP_DEVICE:-$ESP_DEVICE_DEFAULT}"
    if [ ! -b "$esp_device" ]; then
        return 1
    fi

    mkdir -p "$ESP_MOUNT_HINT"
    if mount "$esp_device" "$ESP_MOUNT_HINT" >/dev/null 2>&1; then
        tmp_esp_mount="$ESP_MOUNT_HINT"
        printf '%s\n' "$ESP_MOUNT_HINT"
        return 0
    fi

    tmp_esp_mount="$(mktemp -d)"
    if mount "$esp_device" "$tmp_esp_mount" >/dev/null 2>&1; then
        printf '%s\n' "$tmp_esp_mount"
        return 0
    fi

    repair_esp_filesystem "$esp_device"

    if mount "$esp_device" "$ESP_MOUNT_HINT" >/dev/null 2>&1; then
        tmp_esp_mount="$ESP_MOUNT_HINT"
        printf '%s\n' "$ESP_MOUNT_HINT"
        return 0
    fi

    if mount "$esp_device" "$tmp_esp_mount" >/dev/null 2>&1; then
        printf '%s\n' "$tmp_esp_mount"
        return 0
    fi

    rmdir "$tmp_esp_mount" >/dev/null 2>&1 || true
    tmp_esp_mount=
    return 1
}

repair_esp_filesystem() {
    local esp_device="$1"
    local esp_label=

    if ! command -v mkfs.fat >/dev/null 2>&1; then
        log "mkfs.fat not found; cannot repair $esp_device automatically"
        return 1
    fi

    esp_label="$(blkid -s LABEL -o value "$esp_device" 2>/dev/null || true)"
    if [ -z "$esp_label" ]; then
        esp_label="$ESP_LABEL_DEFAULT"
    fi

    log "mount failed for $esp_device; recreating ESP with 4K sectors"
    mkfs.fat -F 16 -S 4096 -n "$esp_label" "$esp_device" >/dev/null
}

write_limine_config() {
    local target_dir="$1"
    local target_cfg="$target_dir/limine.conf"

    install -Dm644 "$tmp_cfg" "$target_cfg"
    log "wrote $target_cfg"
}

sync_limine_payload() {
    local target_dir="$1"
    local target_kernel="$target_dir/$kernel_rel"
    local target_initramfs="$target_dir/$INITRAMFS_STABLE_REL"
    local dtb_rel=

    if [ "$(realpath -m "$target_dir")" = "$(realpath -m "$BOOT_DIR")" ]; then
        return 0
    fi

    install -Dm644 "$BOOT_DIR/$kernel_rel" "$target_kernel"
    install -Dm644 "$INITRAMFS_STABLE_PATH" "$target_initramfs"

    for dtb_rel in "${DTB_RELS[@]}"; do
        install -Dm644 "$BOOT_DIR/$dtb_rel" "$target_dir/$dtb_rel"
    done
}

install_limine_efi() {
    local esp_dir="$1"
    local target=
    local compat_target=
    local -a compat_targets=(
        "$esp_dir/EFI/BOOT/BOOTAA64.EFI"
        "$esp_dir/EFI/endeavour/shimaa64.efi"
        "$esp_dir/EFI/fedora/shimaa64.efi"
        "$esp_dir/EFI/endeavouros/grubaa64.efi"
    )

    if [ ! -f "$LIMINE_EFI_SOURCE" ]; then
        log "missing Limine EFI binary: $LIMINE_EFI_SOURCE"
        return 1
    fi

    for compat_target in "${compat_targets[@]}"; do
        install -Dm644 "$LIMINE_EFI_SOURCE" "$compat_target"
        log "installed Limine EFI binary to $compat_target"
    done
}

if ! mountpoint -q "$BOOT_DIR"; then
    log "$BOOT_DIR is not mounted; refusing to write Limine config"
    exit 1
fi

ensure_tmpdir
discover_dtbs

kernel_rel=
if [ -f "$BOOT_DIR/$RAW_KERNEL_REL" ]; then
    kernel_rel="$RAW_KERNEL_REL"
elif [ -f "$BOOT_DIR/$GZIP_KERNEL_REL" ]; then
    kernel_rel="$GZIP_KERNEL_REL"
else
    log "no kernel image found under $BOOT_DIR"
    exit 1
fi

initramfs_source=
if [ -n "${PIPA_INITRAMFS_SOURCE:-}" ] && [ -f "${PIPA_INITRAMFS_SOURCE}" ]; then
    initramfs_source="${PIPA_INITRAMFS_SOURCE}"
elif [ -f "$BOOT_DIR/$INITRAMFS_STABLE_REL" ]; then
    initramfs_source="$BOOT_DIR/$INITRAMFS_STABLE_REL"
elif [ -f "$BOOT_DIR/initramfs.img" ]; then
    initramfs_source="$BOOT_DIR/initramfs.img"
else
    shopt -s nullglob
    initramfs_candidates=(/usr/lib/modules/*/initramfs-*.img)
    shopt -u nullglob

    if [ "${#initramfs_candidates[@]}" -gt 0 ]; then
        initramfs_source="$(printf '%s\n' "${initramfs_candidates[@]}" | xargs -r ls -1t | head -n1)"
    fi
fi
if [ -z "$initramfs_source" ]; then
    log "no initramfs image found under /usr/lib/modules or $BOOT_DIR"
    exit 1
fi

initramfs_source_real="$(realpath -m "$initramfs_source")"
initramfs_stable_real="$(realpath -m "$INITRAMFS_STABLE_PATH")"
if [ "$initramfs_source_real" != "$initramfs_stable_real" ]; then
    cp -f "$initramfs_source" "$INITRAMFS_STABLE_PATH"
fi

cmdline="$(tr '\n' ' ' < /etc/cmdline 2>/dev/null | sed -e 's/[[:space:]]\+/ /g' -e 's/^ //' -e 's/ $//' || true)"
if [ -z "$cmdline" ] && [ -f "$BOOT_DIR/cmdline.txt" ]; then
    cmdline="$(tr '\n' ' ' < "$BOOT_DIR/cmdline.txt" | sed -e 's/[[:space:]]\+/ /g' -e 's/^ //' -e 's/ $//')"
fi
if [ -z "$cmdline" ]; then
    cmdline="$DEFAULT_CMDLINE"

    root_uuid="$(findmnt -no UUID / 2>/dev/null || true)"
    root_label="$(findmnt -no LABEL / 2>/dev/null || true)"
    root_source="$(findmnt -no SOURCE / 2>/dev/null || true)"
    boot_label="$(findmnt -no LABEL "$BOOT_DIR" 2>/dev/null || true)"

    if [ -n "$root_uuid" ]; then
        cmdline="root=UUID=$root_uuid $cmdline"
    elif [ -n "$root_label" ]; then
        cmdline="root=LABEL=$root_label $cmdline"
    elif [ -n "$root_source" ]; then
        cmdline="root=$root_source $cmdline"
    fi

    if [ -n "$boot_label" ]; then
        cmdline="$cmdline boot=LABEL=$boot_label"
    fi
fi

tmp_cfg="$(mktemp)"
trap cleanup EXIT

{
    printf 'timeout: 5\n'
    printf 'default_entry: 1\n'
    printf 'remember_last_entry: yes\n\n'

    for dtb_rel in "${DTB_RELS[@]}"; do
        printf '/EndeavourOS ARM (Pipa) - %s\n' "$(dtb_title "$dtb_rel")"
        printf '    protocol: linux\n'
        printf '    kernel_path: boot():/%s\n' "$kernel_rel"
        printf '    module_path: boot():/%s\n' "$INITRAMFS_STABLE_REL"
        printf '    dtb_path: boot():/%s\n' "$dtb_rel"
        printf '    cmdline: %s\n\n' "$cmdline"
    done
} > "$tmp_cfg"

write_limine_config "$BOOT_DIR"

esp_dir=
if esp_dir="$(mount_esp_dir)"; then
    sync_limine_payload "$esp_dir"
    write_limine_config "$esp_dir"
    install_limine_efi "$esp_dir"
else
    log "no mounted EFI system partition found and failed to mount $ESP_DEVICE_DEFAULT; skipping ESP sync"
fi
