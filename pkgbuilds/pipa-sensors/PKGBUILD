pkgname=pipa-sensors
pkgver=1.2
pkgrel=14
pkgdesc="Sensors configs for the Xiaomi Pad 6"
arch=('any')
license=('MIT')
depends=('xiaomi-pipa-firmware' 'iio-sensor-proxy-pipa' 'hexagonrpc')
install='pipa-sensors.install'
source=('81-libssc-xiaomi-pipa.rules'
        'hexagonrpcd-sdsp.conf'
        'pipa-prepare-sensor-persist'
        'pipa-sensors-persist.service'
        'pipa-sensors-resume'
        'iio-sensor-proxy-pipa-audio.conf'
        'pipa-audio-init-sensors.conf'
        'pipa-sensors.install'
        'pipa-sensors.tmpfiles')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 81-libssc-xiaomi-pipa.rules "$pkgdir/usr/lib/udev/rules.d/81-libssc-xiaomi-pipa.rules"
  install -Dm644 hexagonrpcd-sdsp.conf "$pkgdir/usr/share/hexagonrpcd/hexagonrpcd-sdsp.conf"
  install -Dm644 hexagonrpcd-sdsp.conf "$pkgdir/usr/share/hexagonrpcd/hexagonrpcd-adsp-rootpd.conf"
  install -Dm644 hexagonrpcd-sdsp.conf "$pkgdir/usr/share/hexagonrpcd/hexagonrpcd-adsp-sensorspd.conf"
  install -Dm755 pipa-prepare-sensor-persist "$pkgdir/usr/local/bin/pipa-prepare-sensor-persist"
  install -Dm644 pipa-sensors-persist.service "$pkgdir/usr/lib/systemd/system/pipa-sensors-persist.service"
  install -Dm755 pipa-sensors-resume "$pkgdir/usr/lib/systemd/system-sleep/pipa-sensors-resume"
  install -Dm644 iio-sensor-proxy-pipa-audio.conf "$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-pipa-audio.conf"
  install -Dm644 pipa-audio-init-sensors.conf "$pkgdir/usr/lib/systemd/system/pipa-audio-init.service.d/10-sensors.conf"
  install -Dm644 pipa-sensors.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/pipa-sensors.conf"
}
