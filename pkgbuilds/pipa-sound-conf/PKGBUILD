pkgname=pipa-sound-conf
pkgver=1.4
pkgrel=5
pkgdesc="Sound settings for Xiaomi Mi Pad 6 (pipa)"
arch=('any')
license=('custom')
depends=('alsa-ucm-conf-sm8250' 'alsa-utils' 'wireplumber')
install='pipa-sound-conf.install'
source=('51-pipa.conf'
        'pipa-audio-init'
        'pipa-audio-init.service'
        'pipa-sound-conf.install')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
  install -Dm644 51-pipa.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-pipa.conf"
  install -Dm755 pipa-audio-init "$pkgdir/usr/local/bin/pipa-audio-init"
  install -Dm644 pipa-audio-init.service "$pkgdir/usr/lib/systemd/system/pipa-audio-init.service"
}
