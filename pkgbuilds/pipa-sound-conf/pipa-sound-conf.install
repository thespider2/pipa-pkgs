activate_audio_init() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable pipa-audio-init.service >/dev/null 2>&1 || true
    systemctl start pipa-audio-init.service >/dev/null 2>&1 || true
  fi
}

post_install() {
  activate_audio_init
}

post_upgrade() {
  activate_audio_init
}
