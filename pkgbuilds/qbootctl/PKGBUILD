pkgname=qbootctl
pkgver=0.2.2
pkgrel=1
pkgdesc="Qualcomm A/B boot control utility"
arch=('x86_64' 'aarch64')
url="https://github.com/linux-msm/qbootctl"
license=('GPL3')
depends=('glibc')
makedepends=('meson' 'ninja' 'gcc' 'git')
source=("git+https://github.com/linux-msm/qbootctl.git#tag=${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  meson setup build --prefix=/usr
  meson compile -C build
}

package() {
  cd "$pkgname"
  DESTDIR="$pkgdir" meson install -C build
}
