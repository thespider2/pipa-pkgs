From: Ayman <ayman@aymanrgab.com>
Date: Sat, 13 Jun 2026 12:38:10 +0300
Subject: [PATCH] media: i2c: hi846: Retry clock enable and set rate on power_on

Retry clk_prepare_enable() on -EBUSY after camss reload and set MCLK to
24MHz before enabling the clock.

Signed-off-by: Ayman <ayman@aymanrgab.com>

---
 drivers/media/i2c/hi846.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)
---
diff --git a/drivers/media/i2c/hi846.c b/drivers/media/i2c/hi846.c
index d57d72b010cc..8026ab194515 100644
--- a/drivers/media/i2c/hi846.c
+++ b/drivers/media/i2c/hi846.c
@@ -1632,6 +1632,8 @@ static int hi846_power_on(struct hi846 *hi846)
 {
 	struct i2c_client *client = v4l2_get_subdevdata(&hi846->sd);
 	int ret;
+	int retries;
+	struct device *dev = hi846->sd.dev;
 
 	dev_dbg(&client->dev, "hi846-debug: power_on start rst=%d shdn=%d\n",
 		!!hi846->rst_gpio, !!hi846->shutdown_gpio);
@@ -1641,7 +1643,17 @@ static int hi846_power_on(struct hi846 *hi846)
 	if (ret < 0)
 		return ret;
 
-	ret = clk_prepare_enable(hi846->clock);
+	ret = clk_set_rate(hi846->clock, 24000000);
+	if (ret < 0)
+		dev_warn(dev, "Failed to set MCLK rate to 24MHz: %d\n", ret);
+
+	for (retries = 3; retries > 0; retries--) {
+		ret = clk_prepare_enable(hi846->clock);
+		if (ret != -EBUSY)
+			break;
+		dev_dbg(&client->dev, "hi846-debug: power_on clock busy, retrying...\n");
+		usleep_range(5000, 10000);
+	}
 	dev_dbg(&client->dev, "hi846-debug: power_on clock ret=%d\n", ret);
 	if (ret < 0)
 		goto err_reg;
