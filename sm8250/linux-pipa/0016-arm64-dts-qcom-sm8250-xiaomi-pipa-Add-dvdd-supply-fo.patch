From d60334eee764a6753346e9c7973fc5af8d0b8ed6 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Tue, 30 Jun 2026 23:13:55 +0300
Subject: [PATCH] arm64: dts: qcom: sm8250-xiaomi-pipa: Add dvdd supply for
 AW88261 speaker amps

The AW88261 speaker amplifiers were using a dummy regulator for dvdd,
which powers the digital core. Without a real supply, the amps may clip
at high volume due to insufficient digital core voltage.

Wire dvdd to vreg_l8c_1p8 (1.8V, currently unused PMIC LDO) for all
four speaker amplifiers (aw88261_pr, aw88261_sl, aw88261_pl, aw88261_sr).
---
 arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
index cd62403d2924..4352b911c169 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
@@ -815,6 +815,7 @@ aw88261_pr: speaker-amp@36 { // IT IS ACTUALLY TOP RIGHT SPEAKER WHEN TABLET IS
 		status = "okay";
 		reg = <0x36>;
 		#sound-dai-cells = <0>;
+		dvdd-supply = <&vreg_l8c_1p8>;
 		reset-gpios = <&tlmm 144 GPIO_ACTIVE_HIGH>;
 		awinic,audio-channel = <0>;  /* Channel 1 for right front */
 		awinic,sync-flag;
@@ -829,6 +830,7 @@ aw88261_sl: speaker-amp@37 { // IT IS ACTUALLY BOTTOM RIGHT SPEAKER WHEN TABLET
 		status = "okay";
 		reg = <0x37>;
 		#sound-dai-cells = <0>;
+		dvdd-supply = <&vreg_l8c_1p8>;
 		reset-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
 		awinic,audio-channel = <1>;  /* Channel 2 for left surround */
 		awinic,sync-flag;
@@ -868,6 +870,7 @@ aw88261_pl: speaker-amp@34 { // IT IS ACTUALLY SOME LEFT (IDK IF TOP OR BOTTOM)
 		status = "okay";
 		reg = <0x34>;
 		#sound-dai-cells = <0>;
+		dvdd-supply = <&vreg_l8c_1p8>;
 		reset-gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
 		awinic,audio-channel = <2>;  /* Channel 0 for left front */
 		awinic,sync-flag;
@@ -881,6 +884,7 @@ aw88261_sr: speaker-amp@35 { // IT IS ACTUALLY SOME LEFT (IDK IF TOP OR BOTTOM)
 		status = "okay";
 		reg = <0x35>;
 		#sound-dai-cells = <0>;
+		dvdd-supply = <&vreg_l8c_1p8>;
 		reset-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
 		awinic,audio-channel = <3>;  /* Channel 3 for right surround */
 		awinic,sync-flag;
-- 
