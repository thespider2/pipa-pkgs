From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Thu, 2 Jul 2026 07:30:00 +0300
Subject: [PATCH 17/19] remoteproc: qcom: emit uevent on ADSP crash/restart

Emit a uevent when a remoteproc crashes (KOBJ_OFFLINE) or comes back
up (KOBJ_ONLINE) so userspace (hexagonrpcd/libssc) can react
immediately instead of relying on QMI timeouts. The uevent carries
SSR_NAME=<subsystem> and SSR_EVENT=<crash|ready> environment variables.

This eliminates the window where stale QMI requests can produce
NULL GError messages during ADSP state transitions.

Signed-off-by: Ayman Ragab <aymanrar2c@gmail.com>
---
 drivers/remoteproc/qcom_common.c | 26 ++++++++++++++++++++++++++
 drivers/remoteproc/qcom_common.h |  1 +
 2 files changed, 27 insertions(+)

diff --git a/drivers/remoteproc/qcom_common.c b/drivers/remoteproc/qcom_common.c
index 6c31140268ac..e7ddbc3044aa 100644
--- a/drivers/remoteproc/qcom_common.c
+++ b/drivers/remoteproc/qcom_common.c
@@ -448,9 +448,18 @@ static int ssr_notify_start(struct rproc_subdev *subdev)
 		.name = ssr->info->name,
 		.crashed = false,
 	};
+	char *envp;
 
 	srcu_notifier_call_chain(&ssr->info->notifier_list,
 				 QCOM_SSR_AFTER_POWERUP, &data);
+
+	envp = kasprintf(GFP_KERNEL, "SSR_NAME=%s", ssr->info->name);
+	if (envp) {
+		kobject_uevent_env(&ssr->dev->kobj, KOBJ_ONLINE,
+				   (char *[]){ envp, "SSR_EVENT=ready", NULL });
+		kfree(envp);
+	}
+
 	return 0;
 }
 
@@ -461,9 +470,19 @@ static void ssr_notify_stop(struct rproc_subdev *subdev, bool crashed)
 		.name = ssr->info->name,
 		.crashed = crashed,
 	};
+	char *envp;
 
 	srcu_notifier_call_chain(&ssr->info->notifier_list,
 				 QCOM_SSR_BEFORE_SHUTDOWN, &data);
+
+	if (crashed) {
+		envp = kasprintf(GFP_KERNEL, "SSR_NAME=%s", ssr->info->name);
+		if (envp) {
+			kobject_uevent_env(&ssr->dev->kobj, KOBJ_OFFLINE,
+					   (char *[]){ envp, "SSR_EVENT=crash", NULL });
+			kfree(envp);
+		}
+	}
 }
 
 static void ssr_notify_unprepare(struct rproc_subdev *subdev)
@@ -500,6 +519,7 @@ void qcom_add_ssr_subdev(struct rproc *rproc, struct qcom_rproc_ssr *ssr,
 	}
 
 	ssr->info = info;
+	ssr->dev = &rproc->dev;
 	ssr->subdev.prepare = ssr_notify_prepare;
 	ssr->subdev.start = ssr_notify_start;
 	ssr->subdev.stop = ssr_notify_stop;
diff --git a/drivers/remoteproc/qcom_common.h b/drivers/remoteproc/qcom_common.h
index b07fbaa091a0..aa3ae5b2c5f2 100644
--- a/drivers/remoteproc/qcom_common.h
+++ b/drivers/remoteproc/qcom_common.h
@@ -32,6 +32,7 @@ struct qcom_ssr_subsystem;
 struct qcom_rproc_ssr {
 	struct rproc_subdev subdev;
 	struct qcom_ssr_subsystem *info;
+	struct device *dev;
 };
 
 struct qcom_rproc_pdm {
