prepare() {
  cd $_srcname-${_commit}
  cp ../pipa.config .config
  
  patch -p1 < ../0002-media-i2c-ov13b10-Add-debug-logs-for-Pipa-camera-bring-up.patch
  patch -p1 < ../0003-media-i2c-ov13b10-Fix-ACPI-PM-for-device-tree-systems.patch
  patch -p1 < ../0004-media-i2c-hi846-Add-debug-logs-for-Pipa-camera-bring-up.patch
  patch -p1 < ../0005-media-i2c-hi846-Fix-power-on-reset-sequencing.patch
  patch -p1 < ../0006-media-i2c-hi846-Retry-clock-enable-and-set-rate-on-po.patch
  patch -p1 < ../0007-media-i2c-ov13b10-Retry-clock-enable-and-set-rate-on-power_on.patch
  patch -p1 < ../0008-clk-qcom-clk-rcg2-Keep-force-enable-in-shared_enable-t.patch
  patch -p1 < ../0009-media-i2c-ov13b10-Add-get_selection-pad-operation.patch
  patch -p1 < ../0010-media-hi846-Set-clock-to-24MHz.patch
  patch -p1 < ../0012-arm64-dts-qcom-sm8250-xiaomi-pipa-Fix-TDM-dout-pin-d.patch
  patch -p1 < ../0013-arm64-dts-qcom-sm8250-xiaomi-pipa-Fix-OV13B10-rear-c.patch
  patch -p1 < ../0014-media-qcom-camss-Fix-video-pipeline-stop-streaming-s.patch
  patch -p1 < ../0016-arm64-dts-qcom-sm8250-xiaomi-pipa-Add-dvdd-supply-fo.patch
  patch -p1 < ../0017-remoteproc-qcom-emit-uevent-on-ADSP-crash-restart.patch
  patch -p1 < ../0018-soc-qcom-qmi-return-error-on-lookup-server-registra.patch
  patch -p1 < ../0019-soc-qcom-pdr-retry-service-lookup-on-transient-fail.patch
  patch -p1 < ../0020-aw88261-reduce-boot-spam-and-use-sync-start.patch

  make EXTRAVERSION="-${pkgrel}-pipa" olddefconfig
}

build() {
  cd $_srcname-${_commit}
  make EXTRAVERSION="-${pkgrel}-pipa" -j$(nproc) Image Image.gz modules dtbs
}

package_linux-pipa() {
  pkgdesc="The Linux kernel and modules for Xiaomi Pad 6"
  depends=('coreutils' 'dracut' 'kmod' 'xiaomi-pipa-firmware')
  provides=('linux')

  cd $_srcname-${_commit}
  
  local kernver="$(make EXTRAVERSION="-${pkgrel}-pipa" kernelrelease)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  mkdir -p "$pkgdir/boot/dtbs/qcom"
  cp arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz-$kernver"
  cp arch/arm64/boot/Image "$pkgdir/boot/vmlinuz-$kernver.uncompressed"
  cp arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
  cp arch/arm64/boot/Image "$pkgdir/boot/Image"
  cp System.map "$pkgdir/boot/System.map-$kernver"
  cp .config "$pkgdir/boot/config-$kernver"
  cp arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dtb "$pkgdir/boot/dtbs/qcom/"

  make EXTRAVERSION="-${pkgrel}-pipa" INSTALL_MOD_PATH="$pkgdir/usr" modules_install
  
  mkdir -p "$modulesdir/devicetree"
  cp arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dtb "$modulesdir/devicetree/"
  ln -s devicetree "$modulesdir/dtb"
  cp arch/arm64/boot/Image.gz "$modulesdir/vmlinuz"
  cp arch/arm64/boot/Image "$modulesdir/vmlinuz.uncompressed"
  
  rm -f "$modulesdir/build"
  rm -f "$modulesdir/source"
}

package_linux-pipa-headers() {
  pkgdesc="Header files and scripts for building modules for Linux kernel"
  provides=('linux-headers')
  
  cd $_srcname-${_commit}
  local kernver="$(make EXTRAVERSION="-${pkgrel}-pipa" kernelrelease)"
  
  make EXTRAVERSION="-${pkgrel}-pipa" INSTALL_HDR_PATH="$pkgdir/usr" headers_install
}
