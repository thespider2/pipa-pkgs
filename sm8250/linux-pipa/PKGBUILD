pkgname=(linux-pipa linux-pipa-headers)
_srcname=linux
_commit=afac0607a1046fe1dcdd341297a2144d5013272a
pkgver=7.0.8
pkgrel=20
pkgdesc='Linux kernel for Xiaomi Pad 6 (Pipa)'
arch=('aarch64')
