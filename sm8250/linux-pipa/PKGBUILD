license=('GPL2')
install=linux-pipa.install
makedepends=(
  'bc' 'bison' 'cpio' 'flex' 'kmod' 'pahole' 'python'
  'tar' 'xz' 'rsync'
)
options=('!strip')
source=(
  "linux-${_commit}.tar.gz::https://github.com/aymanrgab/linux/archive/${_commit}.tar.gz"
  'pipa.config'
  '0002-media-i2c-ov13b10-Add-debug-logs-for-Pipa-camera-bring-up.patch'
  '0003-media-i2c-ov13b10-Fix-ACPI-PM-for-device-tree-systems.patch'
  '0004-media-i2c-hi846-Add-debug-logs-for-Pipa-camera-bring-up.patch'
  '0005-media-i2c-hi846-Fix-power-on-reset-sequencing.patch'
  '0006-media-i2c-hi846-Retry-clock-enable-and-set-rate-on-po.patch'
  '0007-media-i2c-ov13b10-Retry-clock-enable-and-set-rate-on-power_on.patch'
  '0008-clk-qcom-clk-rcg2-Keep-force-enable-in-shared_enable-t.patch'
  '0009-media-i2c-ov13b10-Add-get_selection-pad-operation.patch'
  '0010-media-hi846-Set-clock-to-24MHz.patch'
