pkgbase=linux-pipa
pkgname=(linux-pipa linux-pipa-headers)
pkgver=7.1.3
pkgrel=2
pkgdesc='Stable kernel for Xiaomi Pad 6'
arch=('aarch64')
_carch=arm64
url='https://kernel.org'
license=('GPL2')
install=linux-pipa.install
makedepends=(
  'bc' 'bison' 'clang' 'cpio' 'flex' 'kmod' 'lld' 'llvm' 'pahole' 'python'
  'tar' 'xz' 'rsync'
)
options=('!strip')
source=(
  "https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz"
  'config-xiaomi-pipa.aarch64'
  '0001-arm64-dts-qcom-sm8250-xiaomi-pipa-Add-device-tree-fo.patch'
  '0002-power-supply-Add-driver-for-Qualcomm-PMIC-fuel-gauge.patch'
  '0003-Input-Add-nt36523-touchscreen-driver.patch'
  '0004-drm-msm-dsi-change-sync-mode-to-sync-on-DSI0-rather-.patch'
  '0005-drm-msm-dsi-support-DSC-configurations-with-slice_pe.patch'
  '0006-drm-panel-Add-support-for-Novatek-NT36532-panel.patch'
  '0007-drivers-media-i2c-ov13b10-add-device-tree-support-an.patch'
  '0008-ASoC-qcom-sm8250-add-tertiary-tdm-support.patch'
  '0010-HACK-ASoC-codecs-aw88261-add-xiaomi-pipa-hacks.patch'
  '0011-FROMLIST-ASoC-qcom-qdsp6-q6afe-fix-clk-vote-response.patch'
  '0012-HACK-ASoC-qcom-qdsp6-q6afe-pretend-the-AFE-vote-didn.patch'
  '0013-Input-keyboard-add-Xiaomi-Nanosic-803-keyboard.patch'
  '0014-UPSTREAM-libbpf-Fix-UAF-in-strset__add_str.patch'
  '0015-arm64-dts-qcom-sm8250-xiaomi-pipa-Unify-single-dtb.patch'
  '0016-drm-panel-novatek-nt36532-add-unified-pipa-compatible.patch'
  '0017-Input-nt36523-try-both-pipa-touch-firmwares.patch'
  '0018-HACK-ASoC-qcom-qdsp6-q6afe-ignore-clock-set-param-er.patch'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "linux-$pkgver"
  cp ../config-xiaomi-pipa.aarch64 .config

  local patch
  for patch in ../*.patch; do
    patch -p1 < "$patch"
  done
}

build() {
  cd "linux-$pkgver"
  unset LDFLAGS
  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="$((pkgrel + 1))-pipa" \
    -j"$(nproc)" Image Image.gz modules dtbs
}

package_linux-pipa() {
  pkgdesc='The Linux kernel and modules for Xiaomi Pad 6'
  depends=('coreutils' 'dracut' 'kmod' 'xiaomi-pipa-firmware')
  provides=('linux')

  cd "linux-$pkgver"

  local kernver
  kernver="$(make ARCH="$_carch" LLVM=1 KBUILD_BUILD_VERSION="$((pkgrel + 1))-pipa" -s kernelrelease)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="$((pkgrel + 1))-pipa" \
    INSTALL_MOD_PATH="$pkgdir/usr" \
    INSTALL_MOD_STRIP=1 \
    modules_install

  rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

  mkdir -p "$pkgdir/boot/dtbs/qcom" "$modulesdir/devicetree"
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz-$kernver"
  install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/vmlinuz-$kernver.uncompressed"
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
  install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/Image"
  install -Dm644 System.map "$pkgdir/boot/System.map-$kernver"
  install -Dm644 .config "$pkgdir/boot/config-$kernver"
  local dtb=sm8250-xiaomi-pipa.dtb
  install -Dm644 "arch/arm64/boot/dts/qcom/$dtb" "$pkgdir/boot/dtbs/qcom/$dtb"
  cp "arch/arm64/boot/dts/qcom/$dtb" "$modulesdir/devicetree/"
  ln -s devicetree "$modulesdir/dtb"
  cp arch/arm64/boot/Image.gz "$modulesdir/vmlinuz"
  cp arch/arm64/boot/Image "$modulesdir/vmlinuz.uncompressed"

  install -Dm644 include/config/kernel.release \
    "$pkgdir/usr/share/kernel/xiaomi-pipa/kernel.release"
}

package_linux-pipa-headers() {
  pkgdesc='Header files and scripts for building modules for Linux kernel'
  provides=('linux-headers')

  cd "linux-$pkgver"
  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="$((pkgrel + 1))-pipa" \
    INSTALL_HDR_PATH="$pkgdir/usr" headers_install
}
