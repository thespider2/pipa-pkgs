pkgbase=linux-pipa
pkgname=(linux-pipa linux-pipa-headers)
pkgver=7.1.7
pkgrel=3
pkgdesc='Stable kernel for Xiaomi Pad 6'
arch=('aarch64')
_carch=arm64
url='https://github.com/PAD6-DEV/linux-7.xx/tree/pipa/7.1.7-Stable'
license=('GPL-2.0-only')
install=linux-pipa.install
makedepends=(
  'bc' 'bison' 'clang' 'cpio' 'flex' 'git' 'kmod' 'lld' 'llvm' 'pahole' 'python'
  'tar' 'xz' 'rsync'
)
options=('!strip')
# PAD6-DEV pipa/7.1.7-Stable + config + DTB duplicate-label fix. AFE hacks archived.
# Bump with: git ls-remote https://github.com/PAD6-DEV/linux-7.xx.git refs/heads/pipa/7.1.7-Stable
_commit=f6344729eb71c1cb0c4189827c679502f4cd85a8
source=(
  "git+https://github.com/PAD6-DEV/linux-7.xx.git#commit=${_commit}"
  'config-xiaomi-pipa.aarch64'
  '0001-arm64-dts-qcom-sm8250-xiaomi-pipa-fix-duplicate-cpu7.patch'
)
sha256sums=('SKIP' 'SKIP'
            'ccd58a4aed8dcb2432d7352599fb1fffdc87ea629ecfc18737599e494f23b857')

prepare() {
  cd linux-7.xx
  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done
  cp ../config-xiaomi-pipa.aarch64 .config

  ./scripts/config --file .config -d LOCALVERSION_AUTO
  ./scripts/config --file .config --set-str LOCALVERSION "-pipa"
  make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
  cd linux-7.xx
  unset LDFLAGS
  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="${pkgrel}-pipa" \
    -j"$(nproc)" Image Image.gz modules dtbs
}

package_linux-pipa() {
  pkgdesc='The Linux kernel and modules for Xiaomi Pad 6'
  depends=('coreutils' 'dracut' 'kmod' 'xiaomi-pipa-firmware')
  provides=('linux')

  cd linux-7.xx

  local kernver
  kernver="$(make ARCH="$_carch" LLVM=1 KBUILD_BUILD_VERSION="${pkgrel}-pipa" -s kernelrelease)"
  local modulesdir="$pkgdir/usr/lib/modules/$kernver"

  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="${pkgrel}-pipa" \
    INSTALL_MOD_PATH="$pkgdir/usr" \
    INSTALL_MOD_STRIP=1 \
    modules_install

  rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

  mkdir -p "$pkgdir/boot/dtbs/qcom" "$modulesdir/devicetree"
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz-$kernver"
  install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/vmlinuz-$kernver.uncompressed"
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
  install -Dm644 arch/arm64/boot/Image "$pkgdir/boot/Image"
  install -Dm644 System.map "$pkgdir/boot/System.map-$kernver"
  install -Dm644 .config "$pkgdir/boot/config-$kernver"
  local dtb=sm8250-xiaomi-pipa.dtb
  install -Dm644 "arch/arm64/boot/dts/qcom/$dtb" "$pkgdir/boot/dtbs/qcom/$dtb"
  cp "arch/arm64/boot/dts/qcom/$dtb" "$modulesdir/devicetree/"
  ln -s devicetree "$modulesdir/dtb"
  cp arch/arm64/boot/Image.gz "$modulesdir/vmlinuz"
  cp arch/arm64/boot/Image "$modulesdir/vmlinuz.uncompressed"

  install -Dm644 include/config/kernel.release \
    "$pkgdir/usr/share/kernel/xiaomi-pipa/kernel.release"
}

package_linux-pipa-headers() {
  pkgdesc='Header files and scripts for building modules for Linux kernel'
  provides=('linux-headers')

  cd linux-7.xx
  make ARCH="$_carch" LLVM=1 \
    KBUILD_BUILD_VERSION="${pkgrel}-pipa" \
    INSTALL_HDR_PATH="$pkgdir/usr" headers_install
}
