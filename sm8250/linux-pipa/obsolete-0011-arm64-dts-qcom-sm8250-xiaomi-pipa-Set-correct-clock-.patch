From afac0607a1046fe1dcdd341297a2144d5013272a Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Mon, 15 Jun 2026 06:15:39 +0300
Subject: [PATCH 11/13] arm64: dts: qcom: sm8250-xiaomi-pipa: Set correct
 clock-frequency and assigned-clocks for camera front

---
 arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
index 35d6eda8e059..a1b71bbafd2b 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
@@ -668,7 +668,9 @@ camera_front: camera@20 {
 		vddio-supply = <&vreg_l1c_1p8>;
 
 		clocks = <&camcc CAM_CC_MCLK3_CLK>;
-		clock-frequency = <19200000>;
+		clock-frequency = <25000000>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <25000000>;
 
 		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
 		pinctrl-0 = <&mclk3_active &camera_front_active>;
