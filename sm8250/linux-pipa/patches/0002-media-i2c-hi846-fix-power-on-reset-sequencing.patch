From c451171803b199fe01441bdda62700835eeb3a06 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Sun, 19 Jul 2026 14:15:37 +0300
Subject: [PATCH 2/8] media: i2c: hi846: fix power-on reset sequencing

---
 drivers/media/i2c/hi846.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/hi846.c b/drivers/media/i2c/hi846.c
index a3f77b8434ca..24b4f56cf8f7 100644
--- a/drivers/media/i2c/hi846.c
+++ b/drivers/media/i2c/hi846.c
@@ -1640,14 +1640,20 @@ static int hi846_power_on(struct hi846 *hi846)
 	if (ret < 0)
 		goto err_reg;
 
+	/* Hold sensor in reset while power and clock stabilize */
+	if (hi846->rst_gpio)
+		gpiod_set_value_cansleep(hi846->rst_gpio, 1);
+	usleep_range(1000, 2000);
+
+	/* Bring sensor out of standby */
 	if (hi846->shutdown_gpio)
 		gpiod_set_value_cansleep(hi846->shutdown_gpio, 0);
+	usleep_range(1000, 2000);
 
-	/* 30us = 2400 cycles at 80Mhz */
-	usleep_range(30, 60);
+	/* Release reset and wait for sensor to initialize */
 	if (hi846->rst_gpio)
 		gpiod_set_value_cansleep(hi846->rst_gpio, 0);
-	usleep_range(30, 60);
+	usleep_range(5000, 10000);
 
 	return 0;
 
