From ef13b6c592f572359168707b6807f2dbc353a0e0 Mon Sep 17 00:00:00 2001
From: Ayman Ragab <aymanrar2c@gmail.com>
Date: Sun, 19 Jul 2026 14:15:57 +0300
Subject: [PATCH 6/8] arm64: dts: qcom: pipa: fix HI846 front camera clocks and
 suspend pinctrl

---
 arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
index a8508609f3a4..a5409f4a9522 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dts
@@ -672,10 +672,13 @@ camera_front: camera@20 {
 
 		clocks = <&camcc CAM_CC_MCLK3_CLK>;
 		clock-frequency = <19200000>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
 
 		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
 		pinctrl-0 = <&mclk3_active &camera_front_active>;
-		pinctrl-names = "default";
+		pinctrl-1 = <&mclk3_suspend &camera_front_suspend>;
+		pinctrl-names = "default", "suspend";
 
 		orientation = <0>; /* Front facing */
 		rotation = <270>;
-- 
2.54.0

