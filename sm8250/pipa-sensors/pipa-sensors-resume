#!/bin/bash
# Restart the SLPI sensor stack after suspend/resume.
case "$1" in
post)
	(
		wait_for_unit() {
			local unit=$1
			local tries=${2:-30}
			local i

			for ((i = 1; i <= tries; i++)); do
				if systemctl is-active --quiet "${unit}"; then
					sleep 1
					return 0
				fi
				sleep 1
			done
			return 1
		}

		stop_iio_sensor_proxy() {
			local i

			systemctl stop iio-sensor-proxy.service 2>/dev/null || true
			for ((i = 1; i <= 15; i++)); do
				systemctl is-active --quiet iio-sensor-proxy.service || return 0
				sleep 1
			done
			systemctl kill --kill-who=all --signal=SIGKILL iio-sensor-proxy.service 2>/dev/null || true
		}

		# Let remoteproc/fastrpc settle after resume.
		sleep 3

		stop_iio_sensor_proxy
		systemctl restart hexagonrpcd-sdsp.service || exit 0
		wait_for_unit hexagonrpcd-sdsp.service 30 || exit 0

		/usr/local/bin/pipa-prepare-sensor-persist >/dev/null 2>&1 || true

		systemctl reset-failed iio-sensor-proxy.service 2>/dev/null || true
		systemctl restart iio-sensor-proxy.service 2>/dev/null || true
	) &
	;;
esac
