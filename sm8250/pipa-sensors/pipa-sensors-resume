#!/bin/bash
# Restart the SLPI sensor stack around suspend/resume.
set -eu

LOG_TAG=pipa-sensors-resume

log() {
	logger -t "$LOG_TAG" "$@"
}

wait_for_unit() {
	local unit=$1
	local tries=${2:-20}
	local i

	for ((i = 1; i <= tries; i++)); do
		if systemctl is-active --quiet "${unit}"; then
			return 0
		fi
		sleep 0.25
	done
	return 1
}

stop_iio_sensor_proxy() {
	local i

	systemctl stop iio-sensor-proxy.service 2>/dev/null || true
	for ((i = 1; i <= 8; i++)); do
		systemctl is-active --quiet iio-sensor-proxy.service || return 0
		sleep 0.25
	done
	systemctl kill --kill-who=all --signal=SIGKILL iio-sensor-proxy.service 2>/dev/null || true
}

resume_sensor_stack() {
	log "resume: restarting sensor stack"

	# Brief pause for remoteproc/fastrpc after SoC wake.
	sleep 1

	if ! systemctl restart hexagonrpcd-sdsp.service; then
		log "resume: failed to restart hexagonrpcd-sdsp"
		return 0
	fi

	if ! wait_for_unit hexagonrpcd-sdsp.service 20; then
		log "resume: hexagonrpcd-sdsp did not become active"
		return 0
	fi

	/usr/local/bin/pipa-prepare-sensor-persist >/dev/null 2>&1 || true

	systemctl reset-failed iio-sensor-proxy.service 2>/dev/null || true
	if systemctl restart iio-sensor-proxy.service; then
		log "resume: iio-sensor-proxy restarted"
	else
		log "resume: iio-sensor-proxy restart failed"
	fi
}

case "$1" in
pre)
	log "suspend: stopping iio-sensor-proxy"
	stop_iio_sensor_proxy
	;;
post)
	log "resume: scheduling sensor stack restart"
	(
		resume_sensor_stack
	) >/dev/null 2>&1 &
	;;
esac
