# Sensor persist layout for hexagonrpcd (SLPI SensorPD)
d /mnt/vendor 0755 root root -
d /mnt/vendor/persist 0755 root root -
d /mnt/vendor/persist/sensors 0755 fastrpc fastrpc -
d /mnt/vendor/persist/sensors/registry 0755 fastrpc fastrpc -
d /mnt/vendor/persist/sensors/registry/registry 0755 fastrpc fastrpc -
f /mnt/vendor/persist/sensors/registry/sns_reg_version 0644 fastrpc fastrpc -
f /mnt/vendor/persist/sensors/registry/temp.json 0644 fastrpc fastrpc -
