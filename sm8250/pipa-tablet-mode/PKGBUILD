pkgname=pipa-tablet-mode
pkgver=1
pkgrel=1
pkgdesc="Auto-switch display scale on keyboard connect/disconnect for Xiaomi Pad 6"
arch=('any')
url="https://github.com/thespider2/pipa-pkgs"
license=('MIT')
depends=('systemd' 'kpipewire' 'qt6-wayland')
source=("pipa-tablet-mode"
        "99-pipa-tablet-mode.rules")
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 pipa-tablet-mode "$pkgdir/usr/libexec/pipa-tablet-mode"
  install -Dm644 99-pipa-tablet-mode.rules "$pkgdir/usr/lib/udev/rules.d/99-pipa-tablet-mode.rules"
}
