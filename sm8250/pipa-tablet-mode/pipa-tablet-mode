#!/bin/bash
# Detect USB keyboard presence and adjust KWin display scale accordingly.
# Called by udev on USB input add/remove, or manually.
set -euo pipefail

KEYBOARD_SCALE="${KEYBOARD_SCALE:-1}"
TABLET_SCALE="${TABLET_SCALE:-2}"
DSI_OUTPUT="${DSI_OUTPUT:-DSI-1}"

keyboard_present=false
for path in /dev/input/by-path/*kbd*; do
    [ -e "$path" ] && keyboard_present=true && break
done

if [ "$keyboard_present" = true ]; then
    new_scale="$KEYBOARD_SCALE"
else
    new_scale="$TABLET_SCALE"
fi

for session in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    username=$(loginctl show-session "$session" -p Name --value 2>/dev/null)
    uid=$(id -u "$username" 2>/dev/null)
    if [ -n "$username" ] && [ -n "$uid" ]; then
        sudo -u "$username" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            kscreen-doctor "output.${DSI_OUTPUT}.scale.${new_scale}" 2>/dev/null || true
    fi
done
