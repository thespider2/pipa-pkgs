#!/usr/bin/make -f
export KBUILD_BUILD_VERSION = 5-pipa
export ARCH = arm64
export LLVM = 1

%:
	dh $@

# Kernel `make distclean` deletes debian/; never let dh run it.
override_dh_auto_clean:

override_dh_auto_configure:
	# kernel.org + device patches (staged as debian/extras).
	cp debian/extras/config-xiaomi-pipa.aarch64 .config
	for p in debian/extras/0*.patch; do \
		[ -f "$$p" ] || continue; \
		patch -p1 -F2 < "$$p" || exit 1; \
	done
	./scripts/config --file .config -d LOCALVERSION_AUTO
	./scripts/config --file .config --set-str LOCALVERSION "-pipa"
	# Snap/snapd needs AppArmor confinement + squashfs (incl. zstd) and enough loop devices.
	./scripts/config --file .config \
		-e SECURITY \
		-e SECURITYFS \
		-e AUDIT \
		-e SECURITY_APPARMOR \
		-e DEFAULT_SECURITY_APPARMOR \
		-d DEFAULT_SECURITY_DAC \
		--set-str DEFAULT_SECURITY apparmor \
		--set-str LSM "landlock,lockdown,yama,integrity,apparmor" \
		-e SQUASHFS \
		-e SQUASHFS_XZ \
		-e SQUASHFS_ZSTD \
		-e SQUASHFS_XATTR \
		-e BLK_DEV_LOOP \
		--set-val BLK_DEV_LOOP_MIN_COUNT 64 \
		-e OVERLAY_FS \
		-e FUSE_FS \
		-e SECCOMP \
		-e SECCOMP_FILTER \
		-e KEYS
	$(MAKE) ARCH=$(ARCH) LLVM=$(LLVM) olddefconfig

override_dh_auto_build:
	unset LDFLAGS; \
	$(MAKE) -j$$(nproc) ARCH=$(ARCH) LLVM=$(LLVM) KBUILD_BUILD_VERSION=$(KBUILD_BUILD_VERSION) \
		Image Image.gz modules dtbs

override_dh_auto_install:
	KernelVer=$$($(MAKE) -s ARCH=$(ARCH) LLVM=$(LLVM) KBUILD_BUILD_VERSION=$(KBUILD_BUILD_VERSION) kernelrelease); \
	$(MAKE) -j$$(nproc) ARCH=$(ARCH) LLVM=$(LLVM) KBUILD_BUILD_VERSION=$(KBUILD_BUILD_VERSION) \
		INSTALL_MOD_PATH=$(CURDIR)/debian/linux-modules-pipa/usr \
		INSTALL_MOD_STRIP=1 \
		modules_install; \
	rm -f debian/linux-modules-pipa/usr/lib/modules/*/build \
		debian/linux-modules-pipa/usr/lib/modules/*/source; \
	install -Dm644 arch/arm64/boot/Image.gz debian/linux-image-pipa/boot/vmlinuz-$$KernelVer; \
	install -Dm644 arch/arm64/boot/Image debian/linux-image-pipa/boot/vmlinuz-$$KernelVer.uncompressed; \
	install -Dm644 arch/arm64/boot/Image.gz debian/linux-image-pipa/boot/Image.gz; \
	install -Dm644 arch/arm64/boot/Image debian/linux-image-pipa/boot/Image; \
	install -Dm644 System.map debian/linux-image-pipa/boot/System.map-$$KernelVer; \
	install -Dm644 .config debian/linux-image-pipa/boot/config-$$KernelVer; \
	ModDir=debian/linux-modules-pipa/usr/lib/modules/$$KernelVer; \
	install -d $$ModDir/devicetree; \
	install -Dm644 arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dtb \
		debian/linux-image-pipa/boot/dtbs/qcom/sm8250-xiaomi-pipa.dtb; \
	cp arch/arm64/boot/dts/qcom/sm8250-xiaomi-pipa.dtb $$ModDir/devicetree/; \
	ln -sfn devicetree $$ModDir/dtb; \
	cp arch/arm64/boot/Image.gz $$ModDir/vmlinuz; \
	cp arch/arm64/boot/Image $$ModDir/vmlinuz.uncompressed; \
	install -Dm644 include/config/kernel.release \
		debian/linux-image-pipa/usr/share/kernel/xiaomi-pipa/kernel.release; \
	$(MAKE) -j$$(nproc) ARCH=$(ARCH) LLVM=$(LLVM) KBUILD_BUILD_VERSION=$(KBUILD_BUILD_VERSION) \
		INSTALL_HDR_PATH=$(CURDIR)/debian/linux-headers-pipa/usr headers_install; \
	find debian/linux-headers-pipa/usr/include -name '.*' -delete

override_dh_strip:
	# Do not strip kernel modules/images

override_dh_dwz:
